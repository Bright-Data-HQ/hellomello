{
  "name": "hellomello",
  "main": "worker/index.js",
  "compatibility_date": "2024-11-01",
  "routes": [
    { "pattern": "clients.brightdata.com.au", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SIGNOFF",
      "id": "c25a169510234860b37d6c9721aa40a1"
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "vahid@brightdata.com.au"
    }
  ],
  "observability": {
    "enabled": true
  }
}
